---
import type { SupportedLocale } from '../../i18n/utils/types';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const content: Record<string, { title: string; description: string; h1: string; text: string; back: string; backHref: string }> = {
  es: {
    title: 'Gracias por escribirnos - SABERO Consulting',
    description: 'Hemos recibido tu mensaje. Te responderemos en menos de 24 horas.',
    h1: 'Gracias por escribirnos',
    text: 'Hemos recibido tu mensaje correctamente. Nuestro equipo te respondera en menos de 24 horas.',
    back: 'Volver al inicio',
    backHref: '/',
  },
  en: {
    title: 'Thank You - SABERO Consulting',
    description: 'We have received your message. We will respond within 24 hours.',
    h1: 'Thank you for reaching out',
    text: "We have received your message. Our team will get back to you within 24 hours.",
    back: 'Back to home',
    backHref: '/en/',
  },
  pt: {
    title: 'Obrigado - SABERO Consulting',
    description: 'Recebemos sua mensagem. Responderemos em ate 24 horas.',
    h1: 'Obrigado por entrar em contato',
    text: 'Recebemos sua mensagem. Nossa equipe respondera em ate 24 horas.',
    back: 'Voltar ao inicio',
    backHref: '/pt/',
  },
  fr: {
    title: 'Merci - SABERO Consulting',
    description: 'Nous avons recu votre message. Nous vous repondrons sous 24 heures.',
    h1: 'Merci de nous avoir ecrit',
    text: "Nous avons bien recu votre message. Notre equipe vous repondra sous 24 heures.",
    back: "Retour a l'accueil",
    backHref: '/fr/',
  },
};

const t = content[locale] || content.es;
---

<section class="gracias-page" aria-label={t.h1}>
  <div class="gracias-card">
    <span class="gracias-icon" aria-hidden="true">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6L9 17l-5-5" />
      </svg>
    </span>
    <h1 class="gracias-title">{t.h1}</h1>
    <p class="gracias-text">{t.text}</p>
    <a class="gracias-btn" href={t.backHref}>{t.back}</a>
  </div>
</section>

<style>
  /* ============================================
     THANK YOU PAGE — Editorial Premium
     Consistente con la pagina de contacto
  ============================================ */
  .gracias-page {
    background: #FAF9F5;
    padding: 120px 0;
    min-height: 55vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gracias-card {
    max-width: 560px;
    margin: 0 auto;
    padding: 56px 48px;
    background: #FFFFFF;
    border: 1px solid #E0D8CC;
    border-radius: 16px;
    text-align: center;
    position: relative;
    box-shadow: 0 12px 32px rgba(11, 47, 125, 0.08);
  }

  .gracias-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #0B2F7D 0%, #E53935 100%);
    border-radius: 16px 16px 0 0;
  }

  .gracias-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #E8F0FF;
    color: #0B2F7D;
    margin-bottom: 24px;
  }

  .gracias-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #0A1628;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .gracias-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #5E6472;
    margin-bottom: 36px;
  }

  .gracias-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 36px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #FFFFFF;
    background: #0B2F7D;
    border: none;
    border-radius: 10px;
    text-decoration: none;
    transition: all 300ms ease;
  }

  .gracias-btn:hover {
    background: #0A2566;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(11, 47, 125, 0.2);
  }

  @media (max-width: 640px) {
    .gracias-page {
      padding: 64px 0;
    }

    .gracias-card {
      padding: 40px 24px;
      margin: 0 16px;
    }

    .gracias-title {
      font-size: 1.5rem;
    }

    .gracias-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

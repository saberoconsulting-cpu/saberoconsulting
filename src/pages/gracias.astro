---
// Root route - Spanish default locale
// Served at /gracias/
import BaseLayout from '../layouts/BaseLayout.astro';
import ThanksPage from '../components/forms/ThanksPage.astro';

const path = '/gracias';
---

<BaseLayout
  title="Gracias por escribirnos - SABERO Consulting"
  description="Hemos recibido tu mensaje. Te responderemos en menos de 24 horas."
  locale="es"
  path={path}
  noIndex
>
  <ThanksPage locale="es" />
</BaseLayout>
